        #     "
        exit 0
    }
    
    xs_run_debug(){
            # \n\$BASH_COMMAND: ${REVERSE} '${BASH_COMMAND[@]}' ${RESET}\
        echo -e "${RED}$(.xs --hl '-')\n# xSHELL DEBUG - begin\
            \n$(.xs --hl '-')${RESET}\n${YELLOW}# 1. variables:${RESET}\n\
            \n\$BASH_SOURCE: ${REVERSE} '$BASH_SOURCE' ${RESET}\
            \n\$DIRSTACK: ${REVERSE} '$DIRSTACK' ${RESET}\
            \n\$FUNCNAME: ${REVERSE} '${FUNCNAME[@]}' ${RESET}\
            
            \n\$xSHELL_PATH: ${REVERSE} '$xSHELL_PATH' ${RESET}\
            
            \n\$xSHELL_LIBS: ${REVERSE} '$(echo -n "${xSHELL_LIBS[@]/$xSHELL_PATH\/}")' ${RESET}\
            \n\$xSHELL_LIBS - count: ${REVERSE} ${#xSHELL_LIBS[@]} ${RESET}\
            
            \n\$xSHELL_DIRS: ${REVERSE} '$(echo -n "${xSHELL_DIRS[@]}")' ${RESET}\
            \n\$xSHELL_DIRS - count: ${REVERSE} ${#xSHELL_DIRS[@]} ${RESET}\

            \n\$XS_SOURCE_FLAG.: ${REVERSE} '$XS_SOURCE_FLAG' ${RESET}\
            \n\$XS_SOURCE_FILES: ${REVERSE} '$XS_SOURCE_FILES' ${RESET}\

