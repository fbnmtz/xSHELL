            \n\$XS_MISSING_REQUIREMENTS: ${REVERSE} '$XS_MISSING_REQUIREMENTS' ${RESET}\
            
            \n\$APP_PATH: ${REVERSE} '$APP_PATH' ${RESET}\
            \n\$APP_DIR.: ${REVERSE} '$APP_DIR' ${RESET}\
            \n\$APP_HOME: ${REVERSE} '$APP_HOME' ${RESET}\
            \n\$APP_DATA: ${REVERSE} '$APP_DATA' ${RESET}\
            \n\$APP_LOG.: ${REVERSE} '$APP_LOG' ${RESET}\

            \n\$@: ${REVERSE} '${XS_ARGS[*]}' ${RESET}\
            \n\$XS_PARAMS: ${REVERSE} '${XS_PARAMS[*]}' ${RESET}\
            \n\$xarg: ${REVERSE} '$xarg' ${RESET}\

            \n\$XS_AUTHOR_NAME: ${REVERSE} '$XS_AUTHOR_NAME' ${RESET}\
            \n\$XS_AUTHOR_MAIL: ${REVERSE} '$XS_AUTHOR_MAIL' ${RESET}\
            \n\$XS_CREATED_AT.: ${REVERSE} '$XS_CREATED_AT' ${RESET}\
            \n\$XS_UPDATED_AT.: ${REVERSE} '$XS_UPDATED_AT' ${RESET}\
            \n\$XS_VERSION: ${REVERSE} '$XS_VERSION' ${RESET}\
            \n\$XS_VERSION_RC: ${REVERSE} '$XS_VERSION_RC' ${RESET}\
            \n$(.xs --hl '-')\n${YELLOW}# 2. xarg function:${RESET}\n\
            \n$(Hash.all "$args_hash" | cut -d '+' -f1 | column -s : -t)\
            \n$(.xs --hl '-')\n${YELLOW}# 3. xrun function:${RESET}\n\
            \n\$@: ${REVERSE} '${xRUN_ARGS}' ${RESET}\
            \n\$APP_ARGS: ${REVERSE} '${XS_PARAMS[*]}' ${RESET}\n\
            \nwhile [ \$1 != \"\" ]; do\
            \n$__runARGS_case_\
            \nshift\
            \ndone\
            \n${RED}$(.xs --hl -)\n# xSHELL DEBUG - end\
            \n$(.xs --hl -)${RESET}";
    }
    
    xs_generate_case(){
         # fill case with options (xarg)
        __runARGS_case_='case $1 in \n'
        __runARGS_case_+=$__RUN_ARGS_CASE_OPTIONS__
        __runARGS_case_+='esac'
        # apply escape codes (\n \t) when print
        __runARGS_case_=$(echo -e $__runARGS_case_)
        
        [ -n "$_XS_ARGS_REQUIRED" ] && .xs --require-one "$@" && unset _XS_ARGS_REQUIRED;

        # loop all params 
        while [ "$1" != "" ]; do
            # run generated 'case' code
            eval "$__runARGS_case_"
            shift
        done
    }

    # Function to handle joint short flags
    handle_joint_short_flags() {
        local joint_flags="$1"  # The joint short flags passed as an argument
        local length=${#joint_flags}  # The length of the joint short flags string

        # Iterate over each character in the joint short flags string
        for (( i=0; i<length; i++ )); do
            local flag="${joint_flags:i:1}"  # Extract the current character (flag)
            XS_PARAMS+=("-$flag")  # Add the individual flag to the XS_PARAMS array
        done
    }
    
    # set default grouping (has more than zero entries with groups? user defined)
    if [ "$(Hash.all | grep -Ei '\+[a-z]' | wc -l)" -gt 0 ]; then
        # create this group for --help and --version options
        xarg --block "Information Options"
    else
        # no user group? use this for all options
        xarg --block "Available Options"
    fi
    # set default args for any script
    XS_CURRENT_VERSION=$XS_VERSION

    # add support to logflags without '--' prefix
    if [ -z "$_xARGS_NO_DAHS"  ]; then 
        _arg_prefix_="--"
    fi

    # gen default help argument
    if [ -z "$no_help" ]; then
        xarg --id "-h,${_arg_prefix_}help"    \
            --code "xarg+=h ; xs_usage --help" \
            --desc "show this help"
            #  --code "formatHelpOptions" \
    fi

    if [ -z "$no_version" ]; then
        # gen default version argument
        xarg --id "-v,${_arg_prefix_}version" \
            --code "xarg+=v ; xs_usage --version" \
            --desc "print version and exit"
    fi
    
    # store arguments/params to be passed to the script
    XS_PARAMS=()
    
    # search for xrun args 
    while [ "$1" != "" ]; do
        # function to force script to receive at last one param/arg
        case "$1" in
            --xapp-data | --xs-app-home)
                shift; xs_create_app_home
            ;;
            --xrequire-one | --xrequire_one | --require-one | --notNull | --not-null)  
                shift; _XS_ARGS_REQUIRED=true
            ;;
            --xreject-unknown | --reject-unknow | --xreject-unknow)
                shift
                __RUN_ARGS_CASE_OPTIONS__+="*) xs_usage --reject-unknow \$1 ;; \n"
            ;;
            --xversion-full | --xversionrc)
                shift; XS_CURRENT_VERSION=$XS_VERSION_RC
            ;;
            --xdebug | --xsdebug) 
                shift; _XS_ARGS_DEBUG=true; 
            ;;
            --xcolors)
                shift; use colors;
            ;;
            --xscolors | --xs-show-colors | --xs-show-colors) 
                shift; xs_show_colors; exit 0;
            ;;
            --xhelp | --xs-help)
                use utils
                [ -z "$RED" ] && use colors
                local _help_viewer=$(xsys.path bat less more cat)
                shift; xs_run_help | $_help_viewer
            ;;
            --xlib-dirs | --xlibs)
                shift;
                [ -z "$RED" ] && use colors
                echo -e "\n${YELLOW}xSHELL LIB directories:${RESET}\n"
                for dir in "${xSHELL_DIRS[@]}"; do
                    echo -e "${GREEN}  \`-> '${dir}${RESET})"
                done
                echo
                exit
            ;;
            --xsrequirements | --xrequirements)
                shift; xs_requirements_report --colors $_REQUIREMENTS_; exit 0;
            ;;
            *)
                XS_PARAMS+=("$1")
                shift
        esac
    done
    
    # Save all arguments
    XS_ARGS=(${XS_PARAMS[@]})

    # Check for joint short flags and expand them
    for arg in "${XS_PARAMS[@]}"; do
        # Check if the argument is a joint short flag (e.g., -abc)
        if [[ "$arg" =~ ^-[a-zA-Z]{2,}$ ]]; then
            handle_joint_short_flags "${arg:1}"  # Call the function to handle the joint short flags
            unset XS_PARAMS[$arg]  # Remove the joint short flag from the XS_PARAMS array
        fi
    done

    xs_generate_case "${XS_PARAMS[@]}"

    [ -n "$_XS_ARGS_DEBUG" ] && xs_run_debug "${xRUN_ARGS[@]}";
}
# Validate if $xarg variable contains a value and run the code block
# Usage: xcase <value> <code_block>
xcase(){
    xs_func ifname
    xs_debug "${REVERSE} ${BASH_SOURCE[1]} - call of $(ifname)() '$*' ${RESET}\n"
    local value="$1"; shift
    local code_block="$@"
    if [[ "$xarg" =~ $value ]]; then
        eval "$code_block"
    fi
}

# internal helper function to set default values
# Usage: .xs <argument>
# `-> argument can be:
#   --init: initialize script variables
#   --require-value <value> <var_name>: require a value for a variable
#   --require-one <args>: require at least one argument
#   --hl <char>: prints a horizontal line with the given character
.xs(){

    case "${1}" in
        --init)
            shift;
            xs_version; xs_created; xs_updated; xs_author_name; xs_author_mail
        ;;
        --require-value)
            shift;
            test -z "$1" && { xs_usage --field-error "$2"; } 
        ;;
        --require-one)
            shift;
            # no arg given?
            if [ -z "$1" ]; then
                # but stdin is a term (then its a pipe / redirect)
                if [[ ! -t 0 ]]; then
                    # has data to be handled by app/script, so ignore and continue
                    true
                else
                    # raise error
                    xs_usage --missing-param
                fi
            fi
        ;;
        --hl | --horizontal-line)
            shift;
            xs_hl $1
        ;;
    esac
}

