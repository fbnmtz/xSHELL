_xLIB_TARRAY_=true;

xs_use oo

# Class OArray
class OArray {
    # property name default_value
    property elements

    # constructor() or init()
    define constructor() {
        # Initialize the elements property as an empty array
        this.elements="()"
    }

    # Method to add an element to the array
    method push() {
        local element="$1"
        local elements=$(this.elements)
        elements=$(echo "$elements" | tr -d '()' | tr ' ' '\n')
        elements="$elements"$'\n'"$element"
        elements=$(echo "$elements" | sort -u | tr '\n' ' ')
        this.elements="($elements)"
    }

    # Method (alias for push)
    method add() {
        this.push "$1"
    }

    # Method to get the size of the array
    method size() {
        local elements=$(this.elements)
        elements=$(echo "$elements" | tr -d '()' | tr ' ' '\n')
        local count=0
        while IFS= read -r line; do
            [ -n "$line" ] && count=$((count + 1))
        done <<< "$elements"
        echo "$count"
    }

    # Method to get the count of elements in the array (alias for size)
    method count() {
        this.size
    }

    # Method to get an element by index
    method at() {
        local index="$1"
        local elements=$(this.elements)
        elements=$(echo "$elements" | tr -d '()' | tr ' ' '\n')
        echo "$elements" | sed -n "$((index + 1))p"
    }

    # Method to check if an element is in the array
    method include() {
        local element="$1"
        local elements=$(this.elements)
        elements=$(echo "$elements" | tr -d '()' | tr ' ' '\n')
        if echo "$elements" | grep -qxF "$element"; then
            echo "true"
        else
            echo "false"
        fi
    }

    # Method to get the index of an element
    method index_of() {
        local element="$1"
        local elements=$(this.elements)
        elements=$(echo "$elements" | tr -d '()' | tr ' ' '\n')
        local index=0
        while IFS= read -r line; do
            if [ "$line" = "$element" ]; then
                echo "$index"
                return 0
            fi
            index=$((index + 1))
        done <<< "$elements"
        echo "-1"
    }
    
    # Method to iterate over the elements of the array
    method each() {
        local arg="$1"
        local block=""
        local line
        local var_names=""

        # --- Detects call form: inline or heredoc ---
        if [[ ! -t 0 ]]; then
            xs_debug -l 3 "heredoc detected"
            # heredoc form: arr.each fruit <<DO ... DO
            #                arr.each i,v   <<DO ... DO
            var_names="$arg"
            while IFS= read -r line; do
                [[ "$line" =~ ^DO$ ]] && break
                block+="$line"$'\n'
            done
        elif [[ "$arg" == *" "* ]]; then
            # inline form: arr.each "echo @element"
            xs_debug -l 3 "inline detected"
            block="$arg"
            # Extract the variable name from @varname, otherwise use "element"
            if [[ "$arg" =~ \@([a-zA-Z_][a-zA-Z0-9_]*) ]]; then
                var_names="${BASH_REMATCH[1]}"
            else
                var_names="element"
            fi
        else
            # new form: arr.each i,v 'DO ... DONE'
            xs_debug -l 3 "string block detected"
            var_names="$arg"
            block="$*"
            # Remove the 'DO' and 'DONE' markers (first and last lines) from the block
            block=$(echo "$block" | sed '1d;$d')
        fi

        # --- Replace @var1 and @var2 with $var1 and $var2 in the block ---
        IFS=',' read -r var1 var2 <<< "$var_names"
        if [ -n "$var2" ]; then
            block=$(echo "$block" | sed "s/@$var1/\$$var1/g")
            block=$(echo "$block" | sed "s/@$var2/\$$var2/g")
        else
            block=$(echo "$block" | sed "s/@$var1/\$$var1/g")
        fi

        # --- Get the elements and iterate over them        
        local elements
        elements=$(this.elements)
        elements=$(echo "$elements" | tr -d '()' | tr ' ' '\n')
        local index=0
        while IFS= read -r element; do
            [ -n "$element" ] && {
                IFS=',' read -r var1 var2 <<< "$var_names"
                if [ -n "$var2" ]; then
                    eval "$var1=$index; $var2=\"$element\"; $block"
                else
                    eval "$var1=\"$element\"; $block"
                fi
            }
            index=$((index + 1))
        done <<< "$elements"
    }

    # Method to remove an element by index
    method delete_at() {
        local index="$1"
        local elements=$(this.elements)
        elements=$(echo "$elements" | tr -d '()' | tr ' ' '\n')
        elements=$(echo "$elements" | sed "$((index + 1))d")
        elements=$(echo "$elements" | tr '\n' ' ')
        this.elements="($elements)"
    }

    # Method to remove the last element of the array
    method pop() {
        local elements=$(this.elements)
        elements=$(echo "$elements" | tr -d '()' | tr ' ' '\n')
        elements=$(echo "$elements" | head -n -1)
        elements=$(echo "$elements" | tr '\n' ' ')
        this.elements="($elements)"
    }

    # Method to clear the array
    method clear() {
        this.elements="()"
    }

    # Method to check if the array is empty
    method empty() {
        local elements=$(this.elements)
        if [ "$elements" = "()" ]; then
            echo "true"
        else
            echo "false"
        fi
    }

    # Method to convert the array to a string
    method to_s() {
        local elements=$(this.elements)
        echo "$elements"
    }

    # Method to get the first element of the array
    method first() {
        this.at 1
    }

    # Method to get the last element of the array
    method last() {
        this.at $(this.size)
    }

}
