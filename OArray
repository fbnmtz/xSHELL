_xLIB_TARRAY_=true;

xs_use oo

# Class OArray
class OArray {
    # property name default_value
    property elements

    # constructor() or init()
    define constructor() {
        # Initialize the elements property as an empty array
        this.elements="()"
    }

    # Method to add an element to the array
    method push() {
        local element="$1"
        local elements=$(this.elements)
        elements=$(echo "$elements" | tr -d '()' | tr ' ' '\n')
        elements="$elements"$'\n'"$element"
        elements=$(echo "$elements" | sort -u | tr '\n' ' ')
        this.elements="($elements)"
    }

    # Method (alias for push)
    method add() {
        this.push "$1"
    }

    # Method to get the size of the array
    method size() {
        local elements=$(this.elements)
        elements=$(echo "$elements" | tr -d '()' | tr ' ' '\n')
        local count=0
        while IFS= read -r line; do
            [ -n "$line" ] && count=$((count + 1))
        done <<< "$elements"
        echo "$count"
    }

    # Method to get the count of elements in the array (alias for size)
    method count() {
        this.size
    }

    # Method to get an element by index
    method at() {
        local index="$1"
        local elements=$(this.elements)
        elements=$(echo "$elements" | tr -d '()' | tr ' ' '\n')
        echo "$elements" | sed -n "$((index + 1))p"
    }

    # Method to check if an element is in the array
    method include() {
        local element="$1"
        local elements=$(this.elements)
        elements=$(echo "$elements" | tr -d '()' | tr ' ' '\n')
        if echo "$elements" | grep -qxF "$element"; then
            echo "true"
        else
            echo "false"
        fi
    }

    # Method to get the index of an element
    method index_of() {
        local element="$1"
        local elements=$(this.elements)
        elements=$(echo "$elements" | tr -d '()' | tr ' ' '\n')
        local index=0
        while IFS= read -r line; do
            if [ "$line" = "$element" ]; then
                echo "$index"
                return 0
            fi
            index=$((index + 1))
        done <<< "$elements"
        echo "-1"
    }

    # Method to iterate over the elements of the array
    method each() {
        local command="$1"
        local elements=$(this.elements)
        elements=$(echo "$elements" | tr -d '()' | tr ' ' '\n')
        while IFS= read -r element; do
            local e=$element; local value=$element; local v=$element
            [ -n "$element" ] && eval "$command \"$element\""
        done <<< "$elements"
    }

    # Method to iterate over the elements of the array executing a block of code
    method each_do() {
        local block="$1"
        local elements=$(this.elements)
        elements=$(echo "$elements" | tr -d '()' | tr ' ' '\n')
        while IFS= read -r element; do
            local e=$element; local value=$element; local v=$element
            [ -n "$element" ] && eval "$block"
        done <<< "$elements"
    }

    # Method to iterate over the elements of the array with index and value
    method each_with_index() {
        local block="$1"
        local elements=$(this.elements)
        elements=$(echo "$elements" | tr -d '()' | tr ' ' '\n')
        local index=0
        while IFS= read -r element; do
            local e=$element; local value=$element; local v=$element
            [ -n "$element" ] && eval "$block"
            index=$((index + 1))
        done <<< "$elements"
    }

    # Method to remove an element by index
    method delete_at() {
        local index="$1"
        local elements=$(this.elements)
        elements=$(echo "$elements" | tr -d '()' | tr ' ' '\n')
        elements=$(echo "$elements" | sed "$((index + 1))d")
        elements=$(echo "$elements" | tr '\n' ' ')
        this.elements="($elements)"
    }

    # Method to remove the last element of the array
    method pop() {
        local elements=$(this.elements)
        elements=$(echo "$elements" | tr -d '()' | tr ' ' '\n')
        elements=$(echo "$elements" | head -n -1)
        elements=$(echo "$elements" | tr '\n' ' ')
        this.elements="($elements)"
    }

    # Method to clear the array
    method clear() {
        this.elements="()"
    }

    # Method to check if the array is empty
    method empty() {
        local elements=$(this.elements)
        if [ "$elements" = "()" ]; then
            echo "true"
        else
            echo "false"
        fi
    }

    # Method to convert the array to a string
    method to_s() {
        local elements=$(this.elements)
        echo "$elements"
    }
}
