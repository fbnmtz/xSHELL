_xLIB_OSTRING_=true

xs_use oo

class OString {
    property value ""

    method __quote() {
        printf '"%s"\n' "$1"
    }

    method initialize() {
        this.value="${1-}"
    }

    method init() {
        this.initialize "$@"
    }

    method to_s() {
        this.__quote "$(this.value)"
    }

    method length() {
        local value
        value="$(this.value)"
        echo "${#value}"
    }

    method size() {
        this.length
    }

    method empty() {
        local value
        value="$(this.value)"
        [ -z "$value" ] && echo true || echo false
    }

    method include() {
        local value needle
        value="$(this.value)"
        needle="$1"
        [[ "$value" == *"$needle"* ]] && echo true || echo false
    }

    method start_with() {
        local value prefix
        value="$(this.value)"
        prefix="$1"
        [[ "$value" == "$prefix"* ]] && echo true || echo false
    }

    method end_with() {
        local value suffix
        value="$(this.value)"
        suffix="$1"
        [[ "$value" == *"$suffix" ]] && echo true || echo false
    }

    method index() {
        local value needle remainder
        value="$(this.value)"
        needle="$1"
        if [ -z "$needle" ]; then
            echo 0
        elif [[ "$value" == *"$needle"* ]]; then
            remainder="${value#*"$needle"}"
            echo "$((${#value} - ${#remainder} - ${#needle}))"
        else
            echo -1
        fi
    }

    method char() {
        local value index offset
        value="$(this.value)"
        index="${1-}"
        if [[ ! "$index" =~ ^[0-9]+$ ]] || [ "$index" -lt 1 ] || [ "$index" -gt "${#value}" ]; then
            this.__quote ""
            return 0
        fi
        offset=$((index - 1))
        this.__quote "${value:offset:1}"
    }

    method __index_get() {
        local value index offset
        value="$(this.value)"
        index="${1-}"
        if [[ ! "$index" =~ ^[0-9]+$ ]] || [ "$index" -lt 1 ] || [ "$index" -gt "${#value}" ]; then
            return 0
        fi
        offset=$((index - 1))
        printf '%s' "${value:offset:1}"
    }

    method __index_set() {
        local value index offset replacement
        value="$(this.value)"
        index="${1-}"
        replacement="${2-}"
        if [[ ! "$index" =~ ^[0-9]+$ ]] || [ "$index" -lt 1 ] || [ "$index" -gt "${#value}" ]; then
            echo "OString: index out of range: $index" >&2
            return 2
        fi
        if [ "${#replacement}" -ne 1 ]; then
            echo "OString: indexed assignment requires exactly one character" >&2
            return 2
        fi
        offset=$((index - 1))
        value="${value:0:offset}${replacement}${value:offset+1}"
        this.value="$value"
    }

    method upcase() {
        local value
        value="$(this.value)"
        this.__quote "${value^^}"
    }

    method downcase() {
        local value
        value="$(this.value)"
        this.__quote "${value,,}"
    }

    method capitalize() {
        local value first rest
        value="$(this.value)"
        first="${value:0:1}"
        rest="${value:1}"
        this.__quote "${first^^}${rest,,}"
    }

    method camelcase() {
        local value word first rest result=""
        local -a words
        value="$(this.value)"
        value=$(printf '%s\n' "$value" | sed -E 's/[^[:alnum:]]+/ /g')
        read -r -a words <<< "$value"
        for word in "${words[@]}"; do
            first="${word:0:1}"
            rest="${word:1}"
            result+="${first^^}${rest,,}"
        done
        this.__quote "$result"
    }

    method snakecase() {
        local value
        value="$(this.value)"
        value=$(printf '%s\n' "$value" | sed -E \
            -e 's/([[:lower:][:digit:]])([[:upper:]])/\1_\2/g' \
            -e 's/([[:upper:]])([[:upper:]][[:lower:]])/\1_\2/g' \
            -e 's/[^[:alnum:]]+/_/g' \
            -e 's/^_+|_+$//g')
        this.__quote "${value,,}"
    }

    method reverse() {
        local value reversed="" index
        value="$(this.value)"
        for ((index = ${#value} - 1; index >= 0; index--)); do
            reversed+="${value:index:1}"
        done
        this.__quote "$reversed"
    }

    method lstrip() {
        local value
        value="$(this.value)"
        while [[ "$value" =~ ^[[:space:]] ]]; do
            value="${value:1}"
        done
        this.__quote "$value"
    }

    method ltrim() {
        this.lstrip
    }

    method rstrip() {
        local value
        value="$(this.value)"
        while [[ "$value" =~ [[:space:]]$ ]]; do
            value="${value:0:${#value}-1}"
        done
        this.__quote "$value"
    }

    method rtrim() {
        this.rstrip
    }

    method strip() {
        local value
        value="$(this.value)"
        while [[ "$value" =~ ^[[:space:]] ]]; do
            value="${value:1}"
        done
        while [[ "$value" =~ [[:space:]]$ ]]; do
            value="${value:0:${#value}-1}"
        done
        this.__quote "$value"
    }

    method trim() {
        this.strip
    }

    method chars() {
        local value char index output=""
        value="$(this.value)"
        for ((index = 0; index < ${#value}; index++)); do
            char="${value:index:1}"
            [ "$index" -gt 0 ] && output+=" "
            output+="$char"
        done
        this.__quote "$output"
    }

    method each() {
        local __ostring_each_arg="${1-}" __ostring_each_block="" __ostring_each_line
        local __ostring_each_names __ostring_each_var1 __ostring_each_var2
        local __ostring_each_value __ostring_each_index __ostring_each_char

        if [[ ! -t 0 ]] && IFS= read -r -t 0 __ostring_each_line; then
            __ostring_each_names="$__ostring_each_arg"
            while :; do
                [[ "$__ostring_each_line" =~ ^DO$ ]] && break
                __ostring_each_block+="$__ostring_each_line"$'\n'
                IFS= read -r __ostring_each_line || break
            done
        elif [[ "$__ostring_each_arg" == *" "* ]]; then
            __ostring_each_block="$__ostring_each_arg"
            if [[ "$__ostring_each_arg" =~ \@([a-zA-Z_][a-zA-Z0-9_]*) ]]; then
                __ostring_each_names="${BASH_REMATCH[1]}"
            else
                __ostring_each_names=char
            fi
        else
            __ostring_each_names="$__ostring_each_arg"
            __ostring_each_block="$*"
            __ostring_each_block=$(printf '%s\n' "$__ostring_each_block" | sed '1d;$d')
        fi

        IFS=',' read -r __ostring_each_var1 __ostring_each_var2 <<< "$__ostring_each_names"
        if [[ ! "$__ostring_each_var1" =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]] || \
            { [ -n "$__ostring_each_var2" ] && [[ ! "$__ostring_each_var2" =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]]; }; then
            echo "OString: each requires valid variable names" >&2
            return 2
        fi

        __ostring_each_block=${__ostring_each_block//@$__ostring_each_var1/\$$__ostring_each_var1}
        if [ -n "$__ostring_each_var2" ]; then
            __ostring_each_block=${__ostring_each_block//@$__ostring_each_var2/\$$__ostring_each_var2}
        fi

        __ostring_each_value="$(this.value)"
        for ((__ostring_each_index = 0; __ostring_each_index < ${#__ostring_each_value}; __ostring_each_index++)); do
            __ostring_each_char="${__ostring_each_value:__ostring_each_index:1}"
            if [ -n "$__ostring_each_var2" ]; then
                printf -v "$__ostring_each_var1" '%s' "$((__ostring_each_index + 1))"
                printf -v "$__ostring_each_var2" '%s' "$__ostring_each_char"
            else
                printf -v "$__ostring_each_var1" '%s' "$__ostring_each_char"
            fi
            eval "$__ostring_each_block"
        done
    }

    method to_array() {
        local value array_object character index constructor_class push_class
        value="$(this.value)"
        array_object="__ostring_array_${BASHPID}_${RANDOM}"
        mkdir -p "$_OO_STORE/instances/$array_object"
        printf 'OArray\n' > "$_OO_STORE/instances/$array_object/__class__"
        constructor_class=$(__oo_resolve_method_class OArray constructor) || return 1
        this="$array_object" "__${constructor_class}_constructor"
        push_class=$(__oo_resolve_method_class OArray push) || return 1
        for ((index = 0; index < ${#value}; index++)); do
            character="${value:index:1}"
            this="$array_object" "__${push_class}_push" "$character"
        done
        printf '%s\n' "$array_object"
    }

    method to_a() {
        this.to_array
    }

    method append() {
        local value
        value="$(this.value)"
        value+="$*"
        this.value="$value"
    }

    method concat() {
        this.append "$@"
    }

    method prepend() {
        local value
        value="$(this.value)"
        this.value="$*${value}"
    }

    method replace() {
        this.value="$*"
    }

    method clear() {
        this.value=""
    }

    method sub() {
        local value pattern replacement
        value="$(this.value)"
        pattern="$1"
        replacement="$2"
        [ -z "$pattern" ] && return 0
        this.value="${value/"$pattern"/"$replacement"}"
    }

    method gsub() {
        local value pattern replacement
        value="$(this.value)"
        pattern="$1"
        replacement="$2"
        [ -z "$pattern" ] && return 0
        this.value="${value//"$pattern"/"$replacement"}"
    }

    method delete() {
        this.gsub "$1" ""
    }
}

# _oo_end_class
xs_use OArray