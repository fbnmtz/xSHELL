xsys.clipboard(){
    case $(xsys.os) in
        Darwin) 
            _xSYS_CLIP_APP="pbcopy"
            _xSYS_CLIP_ARG=""
        ;;
        Linux)  
            _xSYS_CLIP_APP="xclip-cmd"
            _xSYS_CLIP_ARG=""
        ;;
    esac
    eval "$_xSYS_CLIP_APP $_xSYS_CLIP_ARG"
}
function xs_clipboard(){ xsys.clipboard "$@"; }

xsys.menu(){
    case $(xsys.os) in
        Darwin) 
            _xSYS_MENU_APP="choose"
            _xSYS_MENU_ARG=""
        ;;
        Linux)  
            _xSYS_MENU_APP="rofi"
            _xSYS_MENU_ARG="-no-config -dmenu -fuzzy -p '$1'"
        ;;
    esac
    eval "$_xSYS_MENU_APP $_xSYS_MENU_ARG"
}
function xs_menu(){ xsys.menu "$@"; }

# return the path of a binary (utils getPath)
xsys.path(){
    for tool in "$@"; do
        if which "$tool" &> /dev/null; then
            which "$tool"
            return 0
        fi
    done
    return 1
}
function xs_path(){ xsys.path "$@"; }

# function to return a basepath from a file
# @param $1 -> file: /etc/hosts
# @return path to file -> /etc
xsys.basepath(){
    xrequirements rev cut
    echo "$1" | rev | cut -d '/' -f2-30 | rev
}
function xs_basepath(){ xsys.basepath "$@"; }