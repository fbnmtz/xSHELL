# import lib system to your script
source "$xSHELL_INIT"
# Load the oo library
use oo

# ----------------------------------------------------------------------------
# 1. define a Class
# ----------------------------------------------------------------------------

class Vehicle {
    public property type "road"
    public method move() {
        echo "$this.model moving"
    }
}

class Car extends Vehicle {
    public property brand "desconhecida"
    public property model "padrao"
    public property speed "0"

    public method run() {
        echo "car $this.model running (speed: $this.speed km/h)"
    }

    public method acelerar() {
        local v="$1"
        [ -z "$v" ] && v="20"
        this.speed = "$v"
        echo "[$this.brand $this.model] increase to $v km/h"
    }
}

# ----------------------------------------------------------------------------
# 2. instance and using objects
# ----------------------------------------------------------------------------
echo "=== TEST - Object 1 - Class Car ==="
c1 = new Car
c1.brand = honda
c1.model=civic
c1.move
c1.run

echo -e "\n=== Test Methods with args ==="
c1.acelerar 110
c1.run

echo -e "\n=== TEST - Object 2 - Class Car ==="
c2 = new Car
c2.brand = toyota
c2.model=corolla
c2.run
c2.acelerar 140

echo "=== TEST - Object 1 - Class Car ==="
c3 = new Car
c3.brand = ford
c3.model=focus
c3.run
c3.acelerar 80

echo -e "\n=== Dump ==="
c1.class && c1.dump 
c2.class && c2.dump 
c3.class && c3.dump 
