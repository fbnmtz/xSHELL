# Description: 
#  > Example demonstrating Object-Oriented Programming (OO in xSHELL
# ############################################################################
# HISTORY:
#

# import lib system to your script
source "$xSHELL_INIT"
# Load the oo library
xs_use oo

# ----------------------------------------------------------------------------
# 1. Class hierarchy
# ----------------------------------------------------------------------------

# Base class. It uses the short aliases attr and def.
class Vehicle {
    attr category "vehicle"
    prop brand "generic"
    property model "unnamed"
    attribute year "2026"
    private property serial "not-registered"

    def initialize_vehicle() {
        this.category = "vehicle"
        echo "[Vehicle] preparing $this.brand $this.model"
    }

    method identify() {
        echo "$this.year $this.brand $this.model ($this.category)"
    }

    private method inspect_serial() {
        echo "serial=$this.serial"
    }
}

# Car adds public members and overrides move. The constructor explicitly calls
# an inherited initializer because constructors are not automatically chained.
class Car extends Vehicle {
    public property doors "4"
    public property fuel "gasoline"
    protected property traction "front"

    public define init() {
        this.initialize_vehicle
        this.category = "car"
        this.serial = "CAR-$this.brand-$this.year"
    }

    public method move() {
        echo "$this.brand $this.model driving at $this.speed km/h"
    }

    public def accelerate() {
        local amount="$1"
        [ -z "$amount" ] && amount="10"
        this.speed = "$amount"
        echo "$this.brand $this.model accelerated to $this.speed km/h"
    }
}

# ElectricCar demonstrates another inheritance level and a protected member.
class ElectricCar extends Car {
    public property battery "100"
    protected property charging "no"

    public method recharge() {
        this.charging = "yes"
        this.battery = "100"
        echo "$this.brand $this.model recharged: $this.battery%"
    }

    public method move() {
        echo "$this.brand $this.model glides silently at $this.speed km/h"
    }
}

# Motorcycle uses the remaining method alias and block visibility syntax.
class Motorcycle extends Vehicle {
    public property wheels "2"
    public property engine "650cc"

    private:
        property alarm "armed"
        method disable_alarm() {
            this.alarm = "off"
            echo "alarm disabled"
        }

    public:
        property helmet "required"
        define init() {
            this.initialize_vehicle
            this.category = "motorcycle"
        }
        method wheelie() {
            echo "$this.brand $this.model performs a wheelie"
        }
}

# ----------------------------------------------------------------------------
# 2. Objects, assignment, getters and method dispatch
# ----------------------------------------------------------------------------

echo "=== Creating vehicles ==="
car = new Car
car.brand = "Atlas"
car.model = "Comet"
car.year=2025
car.speed = 80

electric = new ElectricCar
electric.brand = "Volt"
electric.model = "E2"
electric.speed = 90
electric.battery = 42

motorcycle = new Motorcycle
motorcycle.brand = "Roadster"
motorcycle.model = "Falcon"
motorcycle.engine = "900cc"

echo -e "\n=== Getters and inherited methods ==="
echo "car.class = $(car.class)"
echo "electric.class = $(electric.class)"
echo "motorcycle.class = $(motorcycle.class)"
car.identify
car.move
electric.identify
electric.move
motorcycle.identify
motorcycle.wheelie

echo -e "\n=== Methods with arguments and state changes ==="
car.accelerate 120
electric.accelerate 140
electric.recharge
echo "electric battery after recharge: $(electric.battery)%"

echo -e "\n=== Visibility declarations ==="
echo "Private/protected declarations are recorded in the class metadata."
echo "The methods below are intentionally declared with those modifiers."
car.inspect_serial
motorcycle.disable_alarm

echo -e "\n=== Full object dumps (inherited members show their owner) ==="
car.dump
electric.dump
motorcycle.dump