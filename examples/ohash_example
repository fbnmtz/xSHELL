#  >
# ############################################################################
# HISTORY:
# Example usage of the OHash class.
#
# shellcheck disable=SC2211
    # `-> this ignores the SC2211 warning about using:
    #   `glob used as a command name` 
    # which is intentional here.
#

source "$xSHELL_INIT"
xs_use OHash

echo ----------------------------------------------------------
echo "OHash - Object creation"
echo ----------------------------------------------------------

echo "config = new OHash; config[:host] = 'localhost'; config[:port] = 3000"
config = new OHash; config[:host] = "localhost"; config[:port] = 3000
echo
echo "   \`-> 1 - 'new OHash' and setting values"
echo
echo "----------------------------------------------------------"
echo

echo "network = { ip_address: '192.168.5.10', netmask: '255.255.255.0', gateway: '192.168.5.1' }"
network = { ip_address: "192.168.5.10", netmask: "255.255.255.0", gateway: "192.168.5.1" }
echo
echo "   \`-> 2 - literal hash creation (single line)"
echo
echo "----------------------------------------------------------"
echo

echo -e "database = { \\
    host: 'db.example.com', \\
    port: 5432, \\
    username: 'dbuser', \\
    password: 'dbpass' \\
}"

database = { \
    host: "db.example.com", \
    port: 5432, \
    username: "dbuser", \
    password: "dbpass" \
}

echo
echo "   \`-> 3 - literal hash creation (multiline without quotes)"
echo
echo "----------------------------------------------------------"
echo


echo 'app = "{
    name: 'MyApp', 
    version: '1.0.0' 
}"'

app = "{
    name: 'MyApp', 
    version: '1.0.0' 
}"
echo
echo "   \`-> 4 - literal hash creation (multiline with quotes)"
echo

echo
echo ----------------------------------------------------------
echo "OHash - Show all object items - .to_s and aliases"
echo ----------------------------------------------------------
echo "config.class                          => $(config.class)"
echo
echo "config.to_s                           => $(config.to_s)"
echo "config                                => $(config)"

echo
echo ----------------------------------------------------------
echo "OHash - Methods and basic usage"
echo ----------------------------------------------------------
echo "config[:host]                         => $(config[:host])"
echo "config[:port]                         => $(config[:port])"
echo
echo "config.set :ip_address '192.168.5.1'"
echo "config.store :protocol 'https'"
config.set :ip_address "192.168.5.1"
config.store :protocol "https"
echo
echo "config[:ip_address]                   => $(config[:ip_address])"
echo "config[:protocol]                     => $(config[:protocol])"
echo "config.fetch :host                    => $(config.fetch :host)"
echo "config.key :protocol                  => $(config.key :protocol)"
echo "config.has_key :port                  => $(config.has_key :port)"
echo "config.keys                           => $(config.keys)"
echo "config.values                         => $(config.values)"
echo "config.include :protocol              => $(config.include :protocol)"
echo "config.member :ip_address             => $(config.member :ip_address)"
echo
echo "config.size / config.count / config.length => $(config.size) / $(config.count) / $(config.length)"

echo
echo "config.delete :ip_address"
config.delete :ip_address
echo
echo "config.to_s after delete              => $(config.to_s)"

echo
echo "network[:ip_address]                  => $(network[:ip_address])"
echo "network[:netmask]                     => $(network[:netmask])"
echo "network[:gateway]                     => $(network[:gateway])"
echo "network.to_s                          => $(network.to_s)"

echo
echo "database[:host]                       => $(database[:host])"
echo "database[:port]                       => $(database[:port])"
echo "database[:username]                   => $(database[:username])"  
echo "database[:password]                   => $(database[:password])"
echo "database.to_s                         => $(database.to_s)"

echo 
echo "app[:name]                            => $(app[:name])"
echo "app[:version]                         => $(app[:version])"
echo "app.to_s                              => $(app.to_s)"

echo
echo ----------------------------------------------------------
echo "OHash - Merge and Iteration"
echo ----------------------------------------------------------

echo "config[:network] = network"
echo "config[:database] = database"
echo "config.merge app"
config[:network] = network
config[:database] = database
config.merge app

echo ----------------------------------------------------------

echo
echo "config.to_s                           => $(config.to_s)"
echo "config[:network]                      => $(config[:network])"
echo "config[:network][:ip_address]         => $(config[:network][:ip_address])"
echo "config.dig :network :ip_address       => $(config.dig :network :ip_address)"

echo
echo ----------------------------------------------------------
echo "change config[:network][:ip_address] to 192.168.5.200"
echo "config[:network][:ip_address] = '192.168.5.200'"
config[:network][:ip_address] = "192.168.5.200"
echo ----------------------------------------------------------

echo
echo "config[:network][:ip_address]         => $(config[:network][:ip_address])"
echo "config.empty                          => $(config.empty)"
echo
echo "config.pretty                         => $(config.pretty)"

echo
echo ----------------------------------------------------------
config.each 'printf "config.each report => %-12s %s\\n" "@key" "@value"'

echo
echo ----------------------------------------------------------
config.each '[[ "@key" == :name ]] && printf "config.each filter (:name) => %s\\n" "@value"'

echo
echo ----------------------------------------------------------
config.each '[[ "@value" == *local* ]] && printf "config.each filter (value contains \"local\") => %s => %s\\n" "@key" "@value"'

echo
echo ----------------------------------------------------------
echo "-- Sum numeric values --"
echo ----------------------------------------------------------
numbers = new OHash
numbers[:first] = 12
numbers[:second] = 8
numbers[:third] = 5

total=$(numbers.each 'printf "%s\\n" "@value"' | awk '{ total += $1 } END { print total + 0 }')
echo "numbers.to_s      => $(numbers.to_s)"
echo "numbers.each values | awk sum => $total"
