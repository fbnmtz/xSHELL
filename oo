# Description: 
#  > Object Orientation (OO) for Bash
#  > Supports class definition, attributes (property, prop, attribute, attr), methods (def, method, define), instantiation, property access, and member visibility (public, protected, private)
#  > Visibility approaches:
#  >   1. Prefix modifiers: public property x; private property y; private method f() { ... }
#  >   2. Access blocks: private: ... public: ... protected: ...
#  >   3. Naming convention: _protected, __private
#  > Example:
#  >   class Car {
#  >     public property brand
#  >     private property chassi
#  >     public def run() { echo "car $this.brand running"; }
#  >     private method check_engine() { echo "checking..."; }
#  >   }
#  >   c1 = new Car
#  >   c1.brand = honda
#  >   c1.run
# 
#  Made with Google Antigravity
# ############################################################################
# HISTORY:
#

_xLIB_OO_=true;

# Enable alias expansion so def, method, define and } work inside scripts
shopt -s expand_aliases

# Initialize volatile in-memory store (RAM /dev/shm preferred, fallback to /tmp)
if [ -d "/dev/shm" ] && [ -w "/dev/shm" ]; then
    _OO_STORE="/dev/shm/xshell-oo-$EUID-$$"
else
    _OO_STORE="/tmp/xshell-oo-$EUID-$$"
fi
mkdir -p "$_OO_STORE/classes" "$_OO_STORE/instances"

# Ensure cleanup of temporary object directory on exit
__oo_cleanup() {
    [ -d "$_OO_STORE" ] && rm -rf "$_OO_STORE"
}
trap '__oo_cleanup' EXIT INT TERM

_OO_CURRENT_CLASS=""
_OO_PREV_FUNCS=""
_OO_KNOWN_FUNCS=""
_OO_PENDING_VIS=""
_OO_BLOCK_VIS="public"
_OO_VIS_MODE="auto"

# Function: visibility
# Sets the visibility mode for the current class.
# Options: auto (default), prefix, blocks, convention
visibility() {
    local mode="$1"
    case "$mode" in
        prefix|blocks|convention|auto)
            _OO_VIS_MODE="$mode"
            ;;
        *)
            echo "oo: Warning: unknown visibility mode '$mode' (supported: auto, prefix, blocks, convention)" >&2
            ;;
    esac
}

# Function: class
# Starts a class definition block.
# Usage:
#   class ClassName { ... }
#   class ClassName --visibility=prefix { ... }
#   class ClassName extends ParentClass { ... }
class() {
    _OO_CURRENT_CLASS="$1"
    _OO_VIS_MODE="auto"
    shift
    while [ $# -gt 0 ]; do
        case "$1" in
            --visibility=*)
                _OO_VIS_MODE="${1#--visibility=}"
                ;;
            -v|--visibility)
                shift
                _OO_VIS_MODE="$1"
                ;;
            extends|:)
                shift
                mkdir -p "$_OO_STORE/classes/$_OO_CURRENT_CLASS"
                echo "$1" > "$_OO_STORE/classes/$_OO_CURRENT_CLASS/parent"
                ;;
        esac
        shift
    done

    mkdir -p "$_OO_STORE/classes/$_OO_CURRENT_CLASS/visibility"
    echo "$_OO_VIS_MODE" > "$_OO_STORE/classes/$_OO_CURRENT_CLASS/vis_mode"
    _OO_PENDING_VIS=""
    _OO_BLOCK_VIS="public"
    _OO_PREV_FUNCS=$(compgen -A function)
    _OO_KNOWN_FUNCS="$_OO_PREV_FUNCS"
    if type xs_debug &>/dev/null; then
        xs_debug -l 2 "oo: class '$_OO_CURRENT_CLASS' definition started (vis_mode: $_OO_VIS_MODE)\n"
    fi
}

# Function: _oo_capture_funcs
# Detects functions defined since last check and determines their visibility.
_oo_capture_funcs() {
    local next_vis="$1"
    local cls="$_OO_CURRENT_CLASS"
    [ -z "$cls" ] && return 0

    local current_funcs
    current_funcs=$(compgen -A function)
    local fn
    for fn in $current_funcs; do
        if ! grep -qxE "$fn" <<< "$_OO_KNOWN_FUNCS"; then
            local vis=""
            local mode="${_OO_VIS_MODE:-auto}"

            # Priority 1: Prefix modifier (Approach 1)
            if [ "$mode" = "auto" ] || [ "$mode" = "prefix" ]; then
                if [ -n "$_OO_PENDING_VIS" ]; then
                    vis="$_OO_PENDING_VIS"
                fi
            fi

            # Priority 2: Block mode (Approach 2)
            if [ -z "$vis" ] && { [ "$mode" = "auto" ] || [ "$mode" = "blocks" ]; }; then
                if [ -n "$_OO_BLOCK_VIS" ] && [ "$_OO_BLOCK_VIS" != "public" ]; then
                    vis="$_OO_BLOCK_VIS"
                fi
            fi

            # Priority 3: Naming convention (Approach 3)
            if [ -z "$vis" ] && { [ "$mode" = "auto" ] || [ "$mode" = "convention" ]; }; then
                if [[ "$fn" =~ ^__ ]]; then
                    vis="private"
                elif [[ "$fn" =~ ^_ ]]; then
                    vis="protected"
                fi
            fi

            # Fallback
            [ -z "$vis" ] && vis="${_OO_BLOCK_VIS:-public}"

            mkdir -p "$_OO_STORE/classes/$cls/visibility"
            echo "$vis" > "$_OO_STORE/classes/$cls/visibility/$fn"
        fi
    done
    _OO_KNOWN_FUNCS="$current_funcs"
    _OO_PENDING_VIS="$next_vis"
}

_oo_set_vis() {
    local vis="$1"
    if [ -n "$_OO_CURRENT_CLASS" ]; then
        _oo_capture_funcs "$vis"
    fi
}

# Aliases for prefix visibility modifiers (Approach 1)
alias private="_oo_set_vis private; "
alias public="_oo_set_vis public; "
alias protected="_oo_set_vis protected; "

# Functions for block visibility mode (Approach 2)
private:()   { _oo_capture_funcs ""; _OO_BLOCK_VIS="private"; _OO_PENDING_VIS=""; }
public:()    { _oo_capture_funcs ""; _OO_BLOCK_VIS="public"; _OO_PENDING_VIS=""; }
protected:() { _oo_capture_funcs ""; _OO_BLOCK_VIS="protected"; _OO_PENDING_VIS=""; }

# Function: property
# Declares an attribute for the current class with optional default value and visibility.
# Usage:
#   property attribute_name [default_value]
#   public property attribute_name [default_value]
#   private property attribute_name [default_value]
#   protected property attribute_name [default_value]
# Function: property
# Declares an attribute for the current class with optional default value and visibility.
# Usage:
#   property attribute_name [default_value]
#   public property attribute_name [default_value]
#   private property attribute_name [default_value]
#   protected property attribute_name [default_value]
property() {
    local attr_name="$1"
    local default_val="$2"
    if [ -n "$_OO_CURRENT_CLASS" ]; then
        local cls="$_OO_CURRENT_CLASS"
        echo "$attr_name" >> "$_OO_STORE/classes/$cls/attrs"
        if [ -n "$default_val" ]; then
            # Handle array values by joining them into a single string
            if [[ "$default_val" =~ ^\(.*\)$ ]]; then
                default_val=$(echo "$default_val" | tr -d '()' | tr ' ' '\n')
            fi
            echo "$default_val" > "$_OO_STORE/classes/$cls/default_${attr_name}"
        fi

        # Determine visibility based on active mode
        local vis=""
        local mode="${_OO_VIS_MODE:-auto}"

        # 1. Prefix modifier
        if [ "$mode" = "auto" ] || [ "$mode" = "prefix" ]; then
            if [ -n "$_OO_PENDING_VIS" ]; then
                vis="$_OO_PENDING_VIS"
                _OO_PENDING_VIS=""
            fi
        fi

        # 2. Block mode
        if [ -z "$vis" ] && { [ "$mode" = "auto" ] || [ "$mode" = "blocks" ]; }; then
            if [ -n "$_OO_BLOCK_VIS" ] && [ "$_OO_BLOCK_VIS" != "public" ]; then
                vis="$_OO_BLOCK_VIS"
            fi
        fi

        # 3. Convention mode
        if [ -z "$vis" ] && { [ "$mode" = "auto" ] || [ "$mode" = "convention" ]; }; then
            if [[ "$attr_name" =~ ^__ ]]; then
                vis="private"
            elif [[ "$attr_name" =~ ^_ ]]; then
                vis="protected"
            fi
        fi

        if type xs_debug &>/dev/null; then
            xs_debug -l 2 "oo: class '$_OO_CURRENT_CLASS' property '$attr_name' registered\n"
        fi

        # Fallback to current block visibility or public
        [ -z "$vis" ] && vis="${_OO_BLOCK_VIS:-public}"

        mkdir -p "$_OO_STORE/classes/$cls/visibility"
        echo "$vis" > "$_OO_STORE/classes/$cls/visibility/$attr_name"
    fi
}

# Aliases and functions: prop, property -> attr
prop()     { property "$@"; }
attribute(){ property "$@"; }
attr()     { property "$@"; }
var()      { property "$@"; }
variable() { property "$@"; }

alias prop="property"
alias attribute="property"
alias attr="property"
alias var="property"
alias variable="property"

# Aliases: def, method, define -> function to support method definitions
# Note: Trailing spaces allow alias chaining (e.g., private method ...)
# Usage:
#   method name( ) { ... }
#   define name() { ... }
#   def name() { ... }
#   function name() { ... }
#   func name() { ... }
alias method="function "
alias define="function "
alias def="function "
# alias function="function "
alias func="function "
alias action="function "

# Function: _oo_end_class
# Closes the class block, detects declared methods, transforms $this.attr accessors,
# and encapsulates methods inside the class namespace (__Class_method).
_oo_end_class() {
    local cls="$_OO_CURRENT_CLASS"
    if [ -n "$cls" ]; then
        # Capture any remaining methods before wrapping up
        _oo_capture_funcs ""

        local curr_funcs
        curr_funcs=$(compgen -A function)
        local fn
        for fn in $curr_funcs; do
            if ! grep -qxE "$fn" <<< "$_OO_PREV_FUNCS"; then
                local fn_def
                fn_def=$(declare -f "$fn")
                # Rewrite method declaration and $this.attr or ${this.attr} accessors
                local rewritten
                rewritten=$(echo "$fn_def" | \
                    sed "1s/^${fn} ()/__${cls}_${fn} ()/" | \
                    sed -E 's/\$\{?this\.([a-zA-Z0-9_]+)\}?/\$(__oo_get "\$this" "\1")/g')
                eval "$rewritten"
                echo "$fn" >> "$_OO_STORE/classes/${cls}/methods"
                unset -f "$fn"
                if type xs_debug &>/dev/null; then
                    xs_debug -l 2 "oo: class '$_OO_CURRENT_CLASS' method '$cls.$fn' registered\n"
                fi
            fi
        done
        _OO_CURRENT_CLASS=""
        _OO_PENDING_VIS=""
        _OO_BLOCK_VIS="public"
        _OO_VIS_MODE="auto"
    fi
}

# Alias } to close class definition
alias }="_oo_end_class"

# Internal property getter
__oo_get() {
    local obj="$1"
    local attr="$2"
    cat "$_OO_STORE/instances/$obj/$attr" 2>/dev/null
}

# Internal property setter
__oo_set() {
    local obj="$1"
    local attr="$2"
    local val="$3"
    echo "$val" > "$_OO_STORE/instances/$obj/$attr"
}

# Finds the class that owns a method, walking up the inheritance chain.
__oo_resolve_method_class() {
    local cls="$1"
    local method="$2"

    while [ -n "$cls" ]; do
        if type "__${cls}_${method}" &>/dev/null; then
            echo "$cls"
            return 0
        fi

        if [ -f "$_OO_STORE/classes/$cls/parent" ]; then
            cls=$(cat "$_OO_STORE/classes/$cls/parent")
        else
            cls=""
        fi
    done

    return 1
}

# Preserve previous command_not_found_handle if already defined
if declare -f command_not_found_handle &>/dev/null && ! declare -f __orig_command_not_found_handle &>/dev/null; then
    eval "$(declare -f command_not_found_handle | sed '1s/command_not_found_handle/__orig_command_not_found_handle/')"
fi

# Intercept object syntax:
# 1. Instantiation: obj = new Class [args...]
# 2. Assignment with spaces: obj.attr = value
# 3. Assignment without spaces: obj.attr=value
# 4. Method dispatch & property get: obj.member [args...] / obj.attr / obj.dump
command_not_found_handle() {
    local cmd="$1"
    shift
    local args=("$@")

    # If inside a method and calling this.attr or this.method
    if [ -n "$this" ]; then
        if [[ "$cmd" =~ ^this\.(.*)$ ]]; then
            cmd="${this}.${BASH_REMATCH[1]}"
        fi
    fi

    # 1. Instantiation: obj = new Class [args...]
    if [ "${args[0]}" = "=" ] && [ "${args[1]}" = "new" ]; then
        local obj="$cmd"
        local cls="${args[2]}"
        mkdir -p "$_OO_STORE/instances/$obj"
        echo "$cls" > "$_OO_STORE/instances/$obj/__class__"

        # Apply default attributes if specified in class definition
        if [ -d "$_OO_STORE/classes/$cls" ]; then
            for def_file in "$_OO_STORE/classes/$cls"/default_*; do
                if [ -f "$def_file" ]; then
                    local aname
                    aname=$(basename "$def_file" | sed 's/^default_//')
                    cp "$def_file" "$_OO_STORE/instances/$obj/$aname"
                fi
            done
        fi

        # Invoke constructor if defined (init or constructor)
        local ctor_args=("${args[@]:3}")
        local ctor_cls
        if ctor_cls=$(__oo_resolve_method_class "$cls" init); then
            this="$obj" "__${ctor_cls}_init" "${ctor_args[@]}"
        elif ctor_cls=$(__oo_resolve_method_class "$cls" constructor); then
            this="$obj" "__${ctor_cls}_constructor" "${ctor_args[@]}"
        fi
        return 0
    fi

    # 2. Attribute assignment with spaces: obj.attr = value
    if [[ "$cmd" =~ ^([a-zA-Z0-9_]+)\.([a-zA-Z0-9_]+)$ ]] && [ "${args[0]}" = "=" ]; then
        local obj="${BASH_REMATCH[1]}"
        local attr="${BASH_REMATCH[2]}"
        local val="${args[*]:1}"
        __oo_set "$obj" "$attr" "$val"
        return 0
    fi

    # 3. Attribute assignment without spaces: obj.attr=value
    if [[ "$cmd" =~ ^([a-zA-Z0-9_]+)\.([a-zA-Z0-9_]+)=(.*)$ ]]; then
        local obj="${BASH_REMATCH[1]}"
        local attr="${BASH_REMATCH[2]}"
        local val="${BASH_REMATCH[3]}"
        __oo_set "$obj" "$attr" "$val"
        return 0
    fi

    # 4. Method call or property inspection: obj.member [args...]
    if [[ "$cmd" =~ ^([a-zA-Z0-9_]+)\.([a-zA-Z0-9_]+)$ ]]; then
        local obj="${BASH_REMATCH[1]}"
        local member="${BASH_REMATCH[2]}"

        if [ -f "$_OO_STORE/instances/$obj/__class__" ]; then
            local cls
            cls=$(cat "$_OO_STORE/instances/$obj/__class__")

            # Method dispatch
            local method_cls
            if method_cls=$(__oo_resolve_method_class "$cls" "$member"); then
                this="$obj" "__${method_cls}_${member}" "${args[@]}"
                return $?
            fi

            # Introspection: obj.class
            if [ "$member" = "class" ]; then
                echo "$cls"
                return 0
            fi

            # Introspection: obj.dump
            if [ "$member" = "dump" ]; then
                echo "=== DUMP OBJECT BEGIN ==="
                echo "[object: $obj <class:$cls>]"
                echo -e "  Property's:"
                local property_cls="$cls"
                local listed_properties=""
                while [ -n "$property_cls" ]; do
                    if [ -f "$_OO_STORE/classes/$property_cls/attrs" ]; then
                        while IFS= read -r aname; do
                            if [ -n "$aname" ] && ! grep -qxF "$aname" <<< "$listed_properties"; then
                                local property_owner=""
                                [ "$property_cls" != "$cls" ] && property_owner=" ($property_cls)"
                                if [ -f "$_OO_STORE/instances/$obj/$aname" ]; then
                                    echo "    $property_owner .$aname == $(cat "$_OO_STORE/instances/$obj/$aname")"
                                elif [ -f "$_OO_STORE/classes/$property_cls/default_${aname}" ]; then
                                    echo "    $property_owner .$aname == $(cat "$_OO_STORE/classes/$property_cls/default_${aname}")"
                                else
                                    echo "    $property_owner .$aname =="
                                fi
                                listed_properties+="$aname"$'\n'
                            fi
                        done < "$_OO_STORE/classes/$property_cls/attrs"
                    fi

                    if [ -f "$_OO_STORE/classes/$property_cls/parent" ]; then
                        property_cls=$(cat "$_OO_STORE/classes/$property_cls/parent")
                    else
                        property_cls=""
                    fi
                done

                for f in "$_OO_STORE/instances/$obj"/*; do
                    [ -f "$f" ] || continue
                    local aname
                    aname=$(basename "$f")
                    [ "$aname" = "__class__" ] && continue
                    grep -qxF "$aname" <<< "$listed_properties" && continue
                    echo "    .$aname == $(cat "$f")"
                done
                echo "  Methods:"
                local method_cls="$cls"
                local listed_methods=""
                while [ -n "$method_cls" ]; do
                    if [ -f "$_OO_STORE/classes/$method_cls/methods" ]; then
                        while IFS= read -r method; do
                            if [ -n "$method" ] && ! grep -qxF "$method" <<< "$listed_methods"; then
                                local method_owner=""
                                [ "$method_cls" != "$cls" ] && method_owner=" ($method_cls)"
                                echo "     $method_owner .$method()"
                                listed_methods+="$method"$'\n'
                            fi
                        done < "$_OO_STORE/classes/$method_cls/methods"
                    fi

                    if [ -f "$_OO_STORE/classes/$method_cls/parent" ]; then
                        method_cls=$(cat "$_OO_STORE/classes/$method_cls/parent")
                    else
                        method_cls=""
                    fi
                done
                echo -e "=== DUMP END ===\n"
                return 0
            fi

            # Getter: obj.attr
            if [ -f "$_OO_STORE/instances/$obj/$member" ]; then
                cat "$_OO_STORE/instances/$obj/$member"
                return 0
            fi
        fi
    fi

    # Delegate to previous handler if available
    if type __orig_command_not_found_handle &>/dev/null; then
        __orig_command_not_found_handle "$cmd" "${args[@]}"
        return $?
    fi

    echo "bash: $cmd: command not found" >&2
    return 127
}
