# Description: 
#  > Base class for collections with multiple elements (OArray, OHash, etc.)
#  > Inherits from OObject. Provides common properties and methods:
#  > elements, size, count, length, empty, each
# ############################################################################
# HISTORY:
#

# Mark the OCollection library module as loaded in xSHELL
_xLIB_OCOLLECTION_=true

# Import OObject base class
xs_use OObject

# Declare class OCollection extending OObject
class OCollection extends OObject {

    # Property elements: common storage/representation attribute
    property elements

    # Method to get the count of elements (alias for size)
    method count() {
        this.size
    }

    # Method to get the length of the collection (alias for size)
    method length() {
        this.size
    }

    # Method to check if the collection is empty
    method empty() {
        local sz
        sz=$(this.size)
        if [ -z "$sz" ] || [ "$sz" -eq 0 ]; then
            echo "true"
        else
            echo "false"
        fi
    }

}

