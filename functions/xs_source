# load debug functions
if ! type is_debug_enabled &> /dev/null; then
  source /dev/stdin <<< "$(curl -s https://raw.githubusercontent.com/fbnmtz/xSHELL/refs/heads/master/functions/xs_debug)"
fi

# def xs_source(filename): function to source a script from the repository (local or using curl)
#   ex: xs_source "args system colors functions/upcase"
function xs_source() {
  local remote="https://raw.githubusercontent.com/fbnmtz/xSHELL/refs/heads/master"
  xs_debug "xs_source running on: $(pwd)"
  # iterate over all libs/functions
  for filename in $@; do
    # test if local filename exist?
    success=false
    for f in "$filename" "./$filename" "./lib/$filename" "./vendor/$filename" "../$filename" "$xSHELL_PATH/$filename"; do
      if source "$f" &> /dev/null ; then
        if is_debug_enabled; then
          xs_debug "xs_source() - succes! loading local file: $f"
        fi
        success=true
        break
      # else
      #   xs_debug "xs_source() - Error! loading local file: $f"
      fi
    done
    # not found yet? try to load from web respository  
    if [ $success == "false" ]; then
      if ! source /dev/stdin <<< "$(curl -s ${remote}/${filename})"; then
        if is_debug_enabled; then
          xs_debug "xs_source() - Error! loading web file: $filename" >&2 && exit 1
        fi
      fi
    fi
  done
}

function xsource () { xs_source "$@"; }
