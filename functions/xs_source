if ! type xs_source &> /dev/null; then

  XS_SOURCE_FILES=''
  XS_SOURCE_BASE_URL="https://raw.githubusercontent.com/fbnmtz/xSHELL/refs/heads/master"

  # load debug functions and colors
  for file in "functions/xs_debug" "colors"; do
    _path="$xSHELL_PATH/$file"
    if [ -f "$_path" ]; then
      source "$_path"
    else
      source /dev/stdin <<< "$(curl -sSL ${XS_SOURCE_BASE_URL}/$file)"
    fi
  done

  # def xs_source(filename): function to source a script from the repository (local or using curl)
  #   ex: xs_source "args system colors upcase"
  function xs_source() {

    # show aliases (functions)
    ifname() {
        local base_index=-1

        for ((i=0; i<${#FUNCNAME[@]}; i++)); do
            if [ "${FUNCNAME[i]}" == "main" ] || [ "${FUNCNAME[i]}" == "source" ]; then
                base_index=$i
                break
            fi
        done
        
        local current_index=''
        if [ "${FUNCNAME[0]}" == "ifname" ]; then
          current_index=1
        else
          current_index=0
        fi
       
        if [ "$base_index" -ne -1 ]; then
        
            local index=$((base_index - current_index))
            if [ "$index" -eq 1 ] ; then
            # && [ "${FUNCNAME[current_index] != "xs_source"}" ]; then
                # echo "ci ${FUNCNAME[*]}"
                echo "${FUNCNAME[index]}"
            elif [ "${FUNCNAME[current_index]}" == "xs_source" ]; then
                local index=$((current_index + 1))
                echo "${FUNCNAME[index]}"
            elif [ "${FUNCNAME[current_index]}" == "main" ]; then
            #  [ "$index" -eq "$base_index" ]; then
                local index=$((index + 2))
                # echo "bi-2 ${FUNCNAME[*]}"
                echo "${FUNCNAME[index]}"
            fi
        else
            # echo "i=2 ${FUNCNAME[*]}"
            echo "${FUNCNAME[2]}"
        fi
    }
    
    if [ "$1" != "ifname" ]; then
      xs_debug "${REVERSE} ${BASH_SOURCE[1]} - call of $(ifname)() '$*' ${RESET}\n"
    # else
    #   xs_debug "${BGRED} ${BASH_SOURCE[1]} - call of $(ifname)() '$*' ${RESET}\n"
    fi

    # define how source files will be get
    case "${1}" in
      -b | --both  | --both-allow) shift; XS_SOURCE_FLAG=b ;;
      -w | --web   | --web-only  ) shift; XS_SOURCE_FLAG=w ;;
      -l | --local | --local-only) shift; XS_SOURCE_FLAG=l ;;
      *) shift; XS_SOURCE_FLAG=n ;;
    esac

    # debug header
    # xs_debug "${REVERSE} $0 - $BASH_SOURCE${RESET} - ${YELLOW}$(ifname)${RESET} (FLAG: ${XS_SOURCE_FLAG}) '${CYAN}$*${RESET}'\n"
    
    # store functions loaded by xs_source among multiple calls 
    for current_file in "$@"; do
      [ -z "$XS_SOURCE_FILES" ] && XS_SOURCE_FILES+="$current_file:$XS_SOURCE_FLAG" || XS_SOURCE_FILES+=" $current_file:$XS_SOURCE_FLAG"
    done

    XS_SOURCE_PATHS=()
    # define paths for local search
    if [ "$XS_SOURCE_FLAG" == "l" ] || [ "$XS_SOURCE_FLAG" == "b" ] || [ "$XS_SOURCE_FLAG" == "n" ]; then
      XS_SOURCE_PATHS+=("$xSHELL_PATH" "$xSHELL_PATH/functions")
    fi

    # define paths for web search
    if [ "$XS_SOURCE_FLAG" == "w" ] || [ "$XS_SOURCE_FLAG" == "b" ]; then
      XS_SOURCE_PATHS+=("${XS_SOURCE_BASE_URL}" "${XS_SOURCE_BASE_URL}/functions")
    fi
    
    # iterate over all libs/functions
    for filename in "$@"; do

      if ! type $filename &> /dev/null; then
       
       for location in "${XS_SOURCE_PATHS[@]}"; do

        f="${location}/${filename}"

        if [[ "$f" =~ ^https?:// ]]; then
          XS_SOURCE_CMD='source /dev/stdin <<< "$(curl -sSL "$f")" &> /dev/null'
          XS_SOURCE_FROM=web
        else
          XS_SOURCE_CMD='source "$f"  &> /dev/null'
          XS_SOURCE_FROM=local
        fi

        if eval "$XS_SOURCE_CMD"; then
          xs_debug --level 2 " \`-> ${YELLOW}$(ifname)${RESET} ${CYAN}%-45s${RESET} ${GREEN}%15s${RESET}\n" $f "[success] ($XS_SOURCE_FROM)"
          # success=true
          break
        else
          # xs_debug " \`-> ${YELLOW}$(ifname)${RESET} ${CYAN}%-45s${RESET} ${RED}%15s${RESET}\n" $f "[Error] (local)"
          if [ -f "$f" ]; then 
            xs_debug --level 2 "${br}$f exists but cant source! Maybe wrong end of line> (CRLF should be LF)${RESET}\n"
            [ ! -x "$f" ] && xs_debug --level 2 "not executable! (need chmod +x $f)\n"
            [ ! -r "$f" ] && xs_debug --level 2 "can not read! (need chmod +r $f)\n"
            exit 3
          # else
          #   xs_debug "$f not found!\n"; exit 2
          fi
        fi
        
       done

      else
        # type $filename true? this function is defined. 
        xs_debug "${YELLOW} !!! $(ifname) - function already defined: ${CYAN}%-17s${RESET} ${YELLOW}%15s${RESET}\n" $filename "[warning] (unknown)"
      fi

    done
  }

  function xsource(){ xs_source "$@"; }
  function xs_file(){ xs_source "$@"; }
  function xs_func(){ xs_source "$@"; }
  function xs_def() { xs_source "$@"; }

else
  xs_debug "Error! Function '$(ifname)' already defined.\n" && exit 3
fi