# def xs_source(filename): function to source a script from the repository (local or using curl)
#   ex: xs_source "args system colors functions/upcase"
function xs_source() {
  local remote="https://raw.githubusercontent.com/fbnmtz/xSHELL/refs/heads/master"
  # iterate over all libs/functions
  for filename in "$@"; do
    # test if local filename exist?
    if [ -f "$filename" ]; then
      if ! source "$filename" && ! source "../$filename" ; then
        echo "xs_source() - Error sourcing local file: $filename" >&2 && exit 1
      fi
    else
      # not found? load it from web (xSHELL repo on github)
      if ! source /dev/stdin <<< "$(curl -s ${remote}/${filename})"; then
        echo "xs_source() - Error sourcing web file: $filename" >&2 && exit 1
      fi
    fi
  done
}

function xsource () { xs_source "$@"; }
