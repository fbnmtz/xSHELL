XS_SOURCE_FILES=''

# load debug functions
if ! type is_debug_enabled &> /dev/null; then
  _xs="$xSHELL_PATH/functions/xs_debug"
  if [ -f "$_xs" ]; then
    source "$_xs"
  else
    source /dev/stdin <<< "$(curl -sSL https://raw.githubusercontent.com/fbnmtz/xSHELL/refs/heads/master/functions/xs_debug)"
  fi
fi

# load colors
if [ -z "${RED}" ] &> /dev/null; then
  source /dev/stdin <<< "$(curl -sSL https://raw.githubusercontent.com/fbnmtz/xSHELL/refs/heads/master/colors)"
fi

# def xs_source(filename): function to source a script from the repository (local or using curl)
#   ex: xs_source "args system colors upcase"
function xs_source() {
  # define remote source
  local remote="https://raw.githubusercontent.com/fbnmtz/xSHELL/refs/heads/master"

  # define how source files will be done
  case "${1}" in
    -b | --both  | --allow-both) shift; XS_SOURCE_FLAG=both  ;;
    -w | --web   | --only-web  ) shift; XS_SOURCE_FLAG=web   ;;
    -l | --local | --only-local) shift; XS_SOURCE_FLAG=local ;;
    *) shift; XS_SOURCE_FLAG=none ;;
  esac

  # debug header
  xs_debug "${REVERSE} $0 ${RESET} (FLAG: ${XS_SOURCE_FLAG}) - ${YELLOW}xs_source ${RESET}'${CYAN}$*${RESET}'\n"
  
  XS_SOURCE_FILES+=$@

  # iterate over all libs/functions
  for filename in $@; do
    # test if local filename exist?
    success=false

    if [ "$XS_SOURCE_FLAG" == "local" ] || [ "$XS_SOURCE_FLAG" == "both" ] || [ "$XS_SOURCE_FLAG" == "none" ]; then
    
      # for f in "$filename" "./$filename" "./lib/$filename" "./vendor/$filename" "../$filename" "$APP_DIR/$filename " "$xSHELL_PATH/$filename"; do
      for f in "$xSHELL_PATH/$filename" "$xSHELL_PATH/functions/$filename"; do
        if source "${f}" &> /dev/null; then
          xs_debug " \`-> ${YELLOW}xs_source${RESET} ${CYAN}%-45s${RESET} ${GREEN}%15s${RESET}\n" $f "[success] (local)"
          success=true
          break
        # else
        #   xs_debug " \`-> ${YELLOW}xs_source${RESET} ${CYAN}$f${RESET} - ${RED}Error - local${RESET}"
        #   [ -f "$f" ] && xs_debug "$f exists but not loaded. (end of line CRLF should be LF)"
        fi
      done
      
    fi
    
    # not found yet? try to load from web respository  
    if [ $success == "false" ]; then
      
      # can source from web?
      if [ "$XS_SOURCE_FLAG" == "web" ] || [ "$XS_SOURCE_FLAG" == "both" ] || [ "$XS_SOURCE_FLAG" == "none" ]; then
        
        for f in "${remote}/${filename}" "${remote}/functions/${filename}"; do
          if source /dev/stdin <<< "$(curl -sSL ${f}) &>/dev/null"; then
            xs_debug " \`-> ${YELLOW}xs_source${RESET} ${CYAN}%-45${RESET} ${GREEN}%15s${RESET}\n" $f "[success] (web)"

            success=true
            break
          fi
        done
        
      fi
     [ "$success" == "false" ] && xs_debug " \`-> ${YELLOW}xs_source${RESET} ${CYAN}$filename${RESET} - ${RED}Error - web${RESET}\n" >&2 && exit 1
    fi
  done
}

function xsource () { xs_source "$@"; }
