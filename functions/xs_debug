is_debug_enabled(){
    if [[ -n "$XSDEBUG" ]] || [[ -n "$D" ]] || [[ -n "$DEBUG" ]]; then
        return 0
    else
        return 1
    fi
}

xs_debug(){
  if is_debug_enabled; then
    echo -e "$@"
    sleep 0.5 
  fi
}