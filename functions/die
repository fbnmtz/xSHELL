function die(){
    # handle args
    case "${1}" in
      -m | --msg ) shift; XS_DIE_MSG="$1"; shift;  ;;
      -e | --exit) shift; XS_DIE_CODE="$1"; shift; ;;
    esac
    
    [ -z "$XS_DIE_MSG"  ] && XS_DIE_MSG="$@"
    [ -z "$XS_DIE_CODE" ] && XS_DIE_CODE=99

    echo "die() - $XS_DIE_MSG" > /dev/stderr
    exit $XS_DIE_CODE
}
