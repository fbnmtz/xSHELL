xs_requirements_report() {

    if [ "$1" == "--colors" ]; then
        shift 
        [ -z "$RED" ] && source "$xSHELL_PATH/colors"
    fi

    local custom_tools_file requirement cmd path

    custom_tools_file="${XS_HOME}/requirements.conf"
    mkdir -p "$(dirname "$custom_tools_file")"

    declare -A XCUSTOM_TOOLS=()
    if [[ -f "$custom_tools_file" ]]; then
        # shellcheck disable=SC1090
        source "$custom_tools_file"
    else
        cat > "$custom_tools_file" <<'EOF'
# xSHELL custom tools mapping
# Map commands that are not in Arch Linux packages to their source locations.
# Format: declare -A XCUSTOM_TOOLS=( [cmd]="source" [cmd2]="source2" )
declare -A XCUSTOM_TOOLS=(
    [mdate]="github:fbnmtz/scripts"
    [mtube]="github:fbnmtz/scripts"
    [xhr]="github:fbnmtz/scripts"
)
EOF
    fi
    local pkg installed alt
    local -a alternatives
    local -A packages
    local -A customs

    # Detect the operating system
    local os
    if [[ "$OSTYPE" == "linux-gnu"* ]]; then
        if [ -f /etc/os-release ]; then
            . /etc/os-release
            os=$ID
        else
            os="unknown"
        fi
    elif [[ "$OSTYPE" == "darwin"* ]]; then
        os="macos"
    else
        os="unknown"
    fi

    # Check if the package database is available
    case $os in
        arch)
            if ! pacman -Fq /usr/bin/bash &>/dev/null; then
                echo "Pacman database not found."
                echo "Execute:"
                echo "  sudo pacman -Fy"
                return 1
            fi
            ;;
        debian|ubuntu)
            if ! dpkg -l &>/dev/null; then
                echo "DPKG database not found."
                echo "Execute:"
                echo "  sudo apt-get update"
                return 1
            fi
            ;;
        fedora|rhel|centos)
            if ! rpm -qa &>/dev/null; then
                echo "RPM database not found."
                echo "Execute:"
                echo "  sudo yum check-update"
                return 1
            fi
            ;;
        macos)
            if ! brew --version &>/dev/null; then
                echo "Homebrew not found."
                echo "Execute:"
                echo "  /bin/bash -c \"$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\""
                return 1
            fi
            ;;
        *)
            echo "Unsupported operating system: $os"
            return 1
            ;;
    esac

    echo -e "${YELLOW}xrequirements '$*'${RESET}"
    printf "${BLUE}%-6s %-30s %s${RESET}" "------" "------------------------------" "------------------------------"
    printf "\n${BLUE}%-6s %-30s %s${RESET}\n" "STATUS" "COMMAND" "PACKAGE/SOURCE"
    printf "${BLUE}%-6s %-30s %s${RESET}\n" "------" "------------------------------" "------------------------------"

    for requirement in $@; do

        cmd=""
        path=""
        installed=0

        #
        # Handle alternatives (cmd1|cmd2|cmd3)
        #
        if [[ "$requirement" == *"|"* ]]; then

            IFS='|' read -ra alternatives <<< "$requirement"

            for alt in "${alternatives[@]}"; do
                if path=$(command -v "$alt" 2>/dev/null); then
                    cmd="$alt"
                    installed=1
                    break
                fi
            done

            # No alternative found
            if [[ -z "$cmd" ]]; then
                cmd="${alternatives[0]}"
            fi

        else

            cmd="$requirement"

            if path=$(command -v "$cmd" 2>/dev/null); then
                installed=1
            fi

        fi

        #
        # Command found
        #
        if (( installed )); then

            # Custom tool
            if [[ -n ${XCUSTOM_TOOLS[$cmd]} ]]; then
                printf "${GREEN}%-6s %-30s %s${RESET}\n" "✔" "$requirement" "${XCUSTOM_TOOLS[$cmd]}"
                continue
            fi

            # Package from package manager
            case $os in
                arch)
                    pkg=$(pacman -Qo "$path" 2>/dev/null | awk '{print $(NF-1)}')
                    ;;
                debian|ubuntu)
                    pkg=$(dpkg -S "$path" 2>/dev/null | cut -d: -f1)
                    ;;
                fedora|rhel|centos)
                    pkg=$(rpm -qf "$path" 2>/dev/null)
                    ;;
                macos)
                    pkg=$(brew list --formula | grep -w "$cmd" 2>/dev/null)
                    ;;
                *)
                    pkg=""
                    ;;
            esac

            if [[ -n "$pkg" ]]; then
                printf "${GREEN}%-6s %-30s %s${RESET}\n" "✔" "$requirement" "$pkg"
            else
                printf "${GREEN}%-6s %-30s (not managed by package manager)${RESET}\n" "✔" "$requirement"
            fi

            continue
        fi

        #
        # Custom tool missing
        #
        if [[ -n ${XCUSTOM_TOOLS[$cmd]} ]]; then
            printf "${RED}%-6s %-30s %s${RESET}\n" "✘" "$requirement" "${XCUSTOM_TOOLS[$cmd]}"
            customs["${XCUSTOM_TOOLS[$cmd]}"]=1
            continue
        fi

        #
        # Search in package database
        #
        case $os in
            arch)
                pkg=$(pacman -Fq "/usr/bin/$cmd" 2>/dev/null | head -n1)
                if [[ -z "$pkg" ]]; then
                    pkg=$(pacman -Fq "$cmd" 2>/dev/null | head -n1)
                fi
                pkg=${pkg#*/}
                ;;
            debian|ubuntu)
                pkg=$(apt-file search "/usr/bin/$cmd" 2>/dev/null | head -n1 | cut -d: -f1)
                if [[ -z "$pkg" ]]; then
                    pkg=$(apt-file search "$cmd" 2>/dev/null | head -n1 | cut -d: -f1)
                fi
                ;;
            fedora|rhel|centos)
                pkg=$(repoquery -f "/usr/bin/$cmd" 2>/dev/null | head -n1)
                if [[ -z "$pkg" ]]; then
                    pkg=$(repoquery -f "$cmd" 2>/dev/null | head -n1)
                fi
                ;;
            macos)
                pkg=$(brew search --formula "$cmd" 2>/dev/null | head -n1)
                ;;
            *)
                pkg=""
                ;;
        esac

        if [[ -n "$pkg" ]]; then
            printf "${RED}%-6s %-30s %s${RESET}\n" "✘" "$requirement" "$pkg"
            packages["$pkg"]=1
        else
            printf "${YELLOW}%-6s %-30s unknown${RESET}\n" "✘" "$requirement"
        fi

    done

    echo

    if ((${#packages[@]})); then
        echo "Packages to install:"
        case $os in
            arch)
                echo "  sudo pacman -S $(printf '%s\n' "${!packages[@]}" | sort | xargs)"
                ;;
            debian|ubuntu)
                echo "  sudo apt-get install $(printf '%s\n' "${!packages[@]}" | sort | xargs)"
                ;;
            fedora|rhel|centos)
                echo "  sudo dnf install $(printf '%s\n' "${!packages[@]}" | sort | xargs)"
                ;;
            macos)
                echo "  brew install $(printf '%s\n' "${!packages[@]}" | sort | xargs)"
                ;;
            *)
                echo "Unsupported operating system: $os"
                ;;
        esac
        echo
    fi

    if ((${#customs[@]})); then
        echo "Custom tools:"
        printf "  %s\n" "${!customs[@]}"
        echo
    fi
}
