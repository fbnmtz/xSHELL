# Function to run a command with sudo
_sudo() {
    _cmd_=$1  # Store the command to be run
    # log "running 'sudo $_cmd_ '"; echo  # Print the command being run
    log "running 'sudo $_cmd_ '"
    eval "$_cmd_"  # Evaluate and run the command
}