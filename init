# def use(lib1, lib2, ...): function to import/use some library
# ex: use args utils mycustomlib
XS_USE_COUNT=0
use(){
  local current_lib current_dir lib
  
  ((XS_USE_COUNT+=1))  # Increment the use counter
  # XS_USE_COUNT=((($XS_USE_COUNT+1)))  # Increment the use counter
  # XS_USE_COUNT+=1  # Increment the use counter
  XS_USE_ALL=$@

  # trackback function caller
  if [ "$XS_USE_COUNT" -eq 1 ]; then 
    # Set the caller and library variables
    XS_USE_CALLER="$0"
    XS_LIB=$1  
  else
    if [ "$XS_USE_CALLER" == "$XS_LIB" ]; then 
      XS_USE_CALLER="$0";
    else
      # Update the caller and library variables if necessary
      XS_USE_CALLER=$XS_LIB  
    fi
  fi
  
  # [ "$XS_USE_CALLLER" == "$0" ] && xs_debug "\n"
  # Print a message indicating that the use function is being called
  xs_debug "call '${YELLOW}use ${MAGENTA}$*${RESET}' from ${CYAN}'$XS_USE_CALLER'${RESET}\n"  
  
  # verify each lib file passed to use() function
  for current_lib in $@; do
    
    # not already loaded?
    if ! is_lib_loaded "$current_lib"; then

      # shellcheck disable=SC2155         # warning - declare and assign separate
      # local current_path=$(dirname "$0")  # Get the directory path of the current script
      # Novo array para armazenar os paths com o arquivo adicionado
      lib_path=()
      

      # Iterar sobre cada item do array original
      for current_dir in "${xSHELL_DIRS[@]}"; do
        # Adicionar o nome do arquivo ao final do path
        lib_path+=("${current_dir}${current_lib}")
      done

      local included=''
      
      # search file in default destinations
      local li=0
      for search_lib in "${lib_path[@]}"; do
        
        xs_debug "  \`-> searching \'${MAGENTA}${search_lib}${RESET}\' --> "

        if source "${search_lib}" 2> /dev/null ; then
          xs_debug "${GREEN}[success]${RESET}\n"
          # [ "$_INIT_DEBUG_" == 'true' ] && echo -e "${GREEN}[success]${RESET}"
          xSHELL_LIBS+=($search_lib)
          XS_USE_CALLER=${search_lib}
          # success? set a flag; break loop
          xs_debug "${GREEN}  \`-> Loading '${search_lib}'${RESET} - ${CYAN}directory: $((li+1))/${#xSHELL_DIRS[@]}${RESET})\n"

          included="true"
        
          break
        else
          xs_debug "${RED}[fail]${RESET}\n"
        fi
        li=$((li+1))
      done
    else 
      # $current_lib already sourced
      included="true"
    fi

    # not included with success? raise a error 
    if [ -z "$included" ]; then
      
      local all_dirs="${xSHELL_DIRS[@]} "
      
      echo -e "${RED}Error! function 'use()' can not find file/lib: ${YELLOW}'${current_lib}'${RED} - FILE NOT FOUND! const ${YELLOW}'\$_xLIB_${current_lib^^}_'${RED} NOT EXIST!${RESET}"
      
      xs_debug "${RED} \`-> searched on:\n   *"\
            "${all_dirs// /${YELLOW}$current_lib - ${RED}[fail]\\n   \* }"\
            "${RESET}\n"
      
      exit 1
    # else
    fi
    
    # test -z "$included" && { 
    #   echo -e "${RED}Error! function 'use()' can not find file/lib: ${YELLOW}'${current_lib}'${RED} - FILE NOT FOUND! const ${YELLOW}'\$_xLIB_${current_lib^^}_'${RED} NOT EXIST!${RESET}"
    #   local all_dirs="${xSHELL_DIRS[@]} "
    #   xs_debug "${RED} \`-> searched on:\n   *"\
    #         "${all_dirs// /${YELLOW}$current_lib - ${RED}[fail]\\n   \* }"\
    #         "${RESET}\n"
    #   exit 1
    # }
  
  done
  XS_USE_COUNT=0
}

# create some aliases for use/import libraries
alias include=use
alias import=use
alias require=use
alias load=use
alias unit=use
alias xuse=use

# def xrequirements(bin1, bin2, "bin3A|bin3B"): function to validate required binaries (bin1, bin2, "bin3A|bin3B")
# ex: xrequirements bin1 bin2 "bin3A|bin3B"
xrequirements(){
  local missing=""
  local found=''
  
  XS_REQUIREMENTS=$*

  # iterate over each tool provided as an argument
  for tool in $XS_REQUIREMENTS; do
    # check if the current tool contains a pipe character (indicating alternatives binaries - bin1|bin2)
    if [[ "$tool" =~ "|" ]]; then
      # iterate over each alternative binary in the list (ex: bin1|bin2)
      for t in ${tool//\|/ }; do 
        # check each alternative binary in the list (ex: bin1)
        if check "$t"; then
          # if the binary is found, set the 'found' flag to true and break the loop
          found=true
          break;
        else
          # if the binary is not found, set the 'found' flag to false and add it to the 'missing' list
          found=false
          [ -z "$XS_MISSING_REQUIREMENTS" ] && XS_MISSING_REQUIREMENTS+="$tool" || XS_MISSING_REQUIREMENTS+=" $tool"
        fi
      done
      [ "$found" != 'true' ] && { fail "$tool"; xs_requirements_report "$XS_MISSING_REQUIREMENTS"; exit 10; }
    else
      # Simple binary (not bin1|bin2) - check if the tool is available on the system
      if ! check "$tool"; then
        # if the binary is not found, set the 'found' flag to false and add it to the 'missing' list
        [ -z "$XS_MISSING_REQUIREMENTS" ] && XS_MISSING_REQUIREMENTS+="$tool" || XS_MISSING_REQUIREMENTS+=" $tool"
        found=false
      else 
        # if the binary is found, set the 'found' flag to true
        found=true
      fi
    fi
  done

  #  
  [ -n "$XS_MISSING_REQUIREMENTS" ] && { fail "$XS_MISSING_REQUIREMENTS"; xs_requirements_report "$XS_MISSING_REQUIREMENTS"; exit 10; }
}

function xs_requirements(){ xrequirements "$@"; }
