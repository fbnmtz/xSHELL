# def use(lib1, lib2, ...): function to import/use some library
# ex: use args utils mycustomlib
_USE_COUNT_=0
use(){
  local lib_file lib dir
  
  ((_USE_COUNT_+=1))  # Increment the use counter
  # _USE_COUNT_=((($_USE_COUNT_+1)))  # Increment the use counter
  # _USE_COUNT_+=1  # Increment the use counter
  _USE_ALL_=$@

  # trackback function caller
  if [ "$_USE_COUNT_" -eq 1 ]; then 
    _CALLER_="$0" ; _LIB_=$1  # Set the caller and library variables
  else
    [ "$_CALLER_" == "$_LIB_" ] && { 
      _CALLER_="$0";
    } || _CALLER_=$_LIB_  # Update the caller and library variables if necessary
  fi
  
  # Print a message indicating that the use function is being called
  xs_debug "call '${YELLOW}use ${MAGENTA}$*${RESET}' from ${CYAN}'$_CALLER_'${RESET}\n"  
  
  for lib_file in $@; do
    
    if ! is_lib_loaded "$lib_file"; then

      # shellcheck disable=SC2155         # warning - declare and assign separate
      # local current_path=$(dirname "$0")  # Get the directory path of the current script
      # Novo array para armazenar os paths com o arquivo adicionado
      lib_dirs=()
      

      # Iterar sobre cada item do array original
      for dir in "${xSHELL_DIRS[@]}"; do
        # Adicionar o nome do arquivo ao final do path
        lib_dirs+=("${dir}${lib_file}")
      done

      local included=''
      
      # search file in default destinations
      local li=0
      for lib in "${lib_dirs[@]}"; do
        
       xs_debug "searching '${MAGENTA}${lib}${RESET}' --> "

        if source "${lib}" 2> /dev/null ; then
          xs_debug "${GREEN}[success]${RESET}\n"
          # [ "$_INIT_DEBUG_" == 'true' ] && echo -e "${GREEN}[success]${RESET}"
          xSHELL_LIBS+=($lib)
          _CALLER_=${lib}
          # success? set a flag; break loop
          xs_debug "${GREEN}  \`-> FOUND! loading '${lib}'${RESET} - ${CYAN}directory: $((li+1))/${#xSHELL_DIRS[@]}${RESET})\n"

          included="true"
        
          break
        else
          xs_debug "${RED}[fail]${RESET}\n"
        fi
        li=$((li+1))
      done
    else 
      included="true"
    fi

    # not included with success? raise a error 
    test -z "$included" && { 
      echo -e "${RED}Error! function 'use()' can not find file/lib: ${YELLOW}'${lib_file}'${RED} - FILE NOT FOUND! const ${YELLOW}'\$_xLIB_${lib_file^^}_'${RED} NOT EXIST!${RESET}"
      local all_dirs="${xSHELL_DIRS[@]} "
      xs_debug "${RED} \`-> searched on:\n   *"\
            "${all_dirs// /${YELLOW}$lib_file - ${RED}[fail]\\n   \* }"\
            "${RESET}\n"
      exit 1
    }
  
  done
  _USE_COUNT_=0
}

# create some aliases for use/import libraries
alias include=use
alias import=use
alias require=use
alias load=use
alias unit=use
alias xuse=use

# def xrequirements(bin1, bin2, "bin3A|bin3B"): function to validate required binaries (bin1, bin2, "bin3A|bin3B")
# ex: xrequirements bin1 bin2 "bin3A|bin3B"
xrequirements(){
  local missing=""
  local found=''
  
  _REQUIREMENTS_=$*

  # iterate over each tool provided as an argument
  for tool in $_REQUIREMENTS_; do
    # check if the current tool contains a pipe character (indicating alternatives binaries - bin1|bin2)
    if [[ "$tool" =~ "|" ]]; then
      # iterate over each alternative binary in the list (ex: bin1|bin2)
      for t in ${tool//\|/ }; do 
        # check each alternative binary in the list (ex: bin1)
        if check "$t"; then
          # if the binary is found, set the 'found' flag to true and break the loop
          found=true
          break;
        else
          # if the binary is not found, set the 'found' flag to false and add it to the 'missing' list
          found=false
          [ -z "$_MISSING_REQUIREMENTS_" ] && _MISSING_REQUIREMENTS_+="$tool" || _MISSING_REQUIREMENTS_+=" $tool"
        fi
      done
      [ "$found" != 'true' ] && { fail "$tool"; xs_requirements_report "$_MISSING_REQUIREMENTS_"; exit 10; }
    else
      # Simple binary (not bin1|bin2) - check if the tool is available on the system
      if ! check "$tool"; then
        # if the binary is not found, set the 'found' flag to false and add it to the 'missing' list
        [ -z "$_MISSING_REQUIREMENTS_" ] && _MISSING_REQUIREMENTS_+="$tool" || _MISSING_REQUIREMENTS_+=" $tool"
        found=false
      else 
        # if the binary is found, set the 'found' flag to true
        found=true
      fi
    fi
  done

  #  
  [ -n "$_MISSING_REQUIREMENTS_" ] && { fail "$_MISSING_REQUIREMENTS_"; xs_requirements_report "$_MISSING_REQUIREMENTS_"; exit 10; }
}

function xs_requirements(){ xrequirements "$@"; }
